{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartmates",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-11-06",
  "vars": {
    "APP_ORIGIN": "http://localhost:8788",
    "GROUP_DISPLAY_NAME": "Our Groceries"
  },
  "durable_objects": {
    "bindings": [{ "name": "LIST", "class_name": "SharedList", "script_name": "cartmates-state" }]
  },
  "env": {
    "preview": {
      "durable_objects": {
        "bindings": [{ "name": "LIST", "class_name": "SharedList", "script_name": "cartmates-state-preview" }]
      }
    },
    "production": {
      "durable_objects": {
        "bindings": [{ "name": "LIST", "class_name": "SharedList", "script_name": "cartmates-state-production" }]
      }
    }
  }
}
